{
  "name": "gallery-app-monorepo",
  "version": "1.0.23",
  "private": true,
  "description": "Privacy-First AI Photo Gallery Ecosystem (Android + Windows)",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:windows": "pnpm --filter @gallery/windows dev",
    "dev:android": "pnpm --filter @gallery/android start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "rea": "npx --yes rea-agents",
    "rea:mcp": "npx --yes rea-agents --mcp",
    "rea:doctor": "npx --yes rea-agents doctor"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "@types/node": "^22.13.10",
    "@babel/runtime": "^7.26.0"
  }
}
