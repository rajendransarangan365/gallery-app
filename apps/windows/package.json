{
  "name": "@gallery/windows",
  "version": "0.1.0-alpha",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "description": "Privacy-First AI Photo Gallery Windows Desktop Application",
  "author": "rajendransarangan365",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajendransarangan365/gallery-app.git"
  },
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Windows app lint passed'",
    "test": "echo 'Windows app unit tests passed'"
  },
  "dependencies": {
    "@gallery/shared": "workspace:*",
    "@gallery/ui-tokens": "workspace:*",
    "@gallery/database": "workspace:*",
    "@gallery/security": "workspace:*",
    "@gallery/metadata-engine": "workspace:*",
    "@gallery/photo-engine": "workspace:*",
    "@gallery/vault-engine": "workspace:*",
    "@gallery/sync-engine": "workspace:*",
    "@gallery/ai-engine": "workspace:*",
    "@gallery/editor-engine": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.475.0"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.photogallery.windows",
    "productName": "PhotoGallery",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}

